# --- Go specific ---
bin/
obj/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
vendor/

# --- go-zero specific ---
# Ignore the main binaries generated by 'go build' or 'go-zero'
# If you name your services service-api, service-rpc, etc.
*-api
*-rpc
/etc/*.yaml
# But don't ignore the template configs (usually ending in .yaml)
# If you use a naming convention like config.yaml for local, ignore it:
# config.yaml

# --- Logs ---
logs/
*.log
# go-zero default log output directory
access.log
error.log
stat.log

# --- Environment & Secrets ---
.env
.env.*
!.env.example
# If you store local certificates for TLS
certs/
*.pem
*.key

# --- Docker & Compose ---
.docker/
# Ignore local data folders for databases/redis
data/
pgdata/
redis-data/

# --- Tools & IDEs ---
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# --- SQL / Migrations ---
# If your migration tool generates temporary files
*.sql.bak
